{
  "name": "gringotts",
  "version": "1.5.1",
  "description": "Aplicativo de Controle Financeiro Pessoal Offline-First inspirado no Denaro",
  "main": "build/main/index.js",
  "scripts": {
    "build:main": "tsc",
    "build:renderer": "npm --prefix renderer run build",
    "build": "npm run build:main && npm run build:renderer",
    "renderer:dev": "npm --prefix renderer run dev",
    "electron:dev": "electron .",
    "dev": "npm run build:main && concurrently -k \"npm run renderer:dev\" \"electron .\"",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "mobile:sync": "npm run build:renderer && cd renderer && npx cap sync android",
    "mobile:open": "cd renderer && npx cap open android"
  },
  "keywords": [
    "finance",
    "offline-first",
    "electron",
    "typescript",
    "react",
    "personal-finance"
  ],
  "author": "JaoOlvr <joaoolvr@outlook.com>",
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.gringotts.app",
    "productName": "Gringotts",
    "publish": [
      {
        "provider": "github",
        "owner": "JaoOlvr",
        "repo": "gringotts"
      }
    ],
    "directories": {
      "output": "dist-electron",
      "buildResources": "resources"
    },
    "files": [
      "build/**/*",
      "renderer/dist/**/*",
      "resources/tessdata/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office;Finance",
      "icon": "resources/icon.png",
      "maintainer": "joaoolvr@outlook.com",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gringotts"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance",
      "icon": "resources/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.11",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.64.0",
    "postcss": "^8.5.30",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
